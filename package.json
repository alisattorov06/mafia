{
  "name": "mafia",
  "version": "1.0.0",
  "description": "MAFIA — a production-ready real-time multiplayer social deduction game",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./client/assets/css/input.css -o ./client/assets/css/tailwind.css --minify",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "node --test 'tests/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'tests/*.test.js'"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^3.4.17"
  },
  "postinstall": "prisma generate"
}
