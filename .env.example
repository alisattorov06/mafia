# --- Server ---
# Port the HTTP + Socket.IO server listens on.
# Render injects its own PORT — you don't need to set it there.
PORT=3000

# Restrict Socket.IO origins (comma separated). When left EMPTY, the server
# reflects the request origin, so same-origin hosting works everywhere.
# CORS_ORIGIN=https://mafia.quizlab.uz

# --- Database (optional) ---
# If left unset the game runs fully in-memory (no persistence).
# On Render use the internal hostname (dpg-xxxx-a); it only resolves inside Render.
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-d9ssgjqjobas7380ivbg-a:5432/mafia_d5he

# --- Security ---
# Session secret used to sign anything sensitive (Render can generate one).
SESSION_SECRET=change-me-to-a-long-random-string

# Max players per room (hard cap; UI limits by mode too)
MAX_PLAYERS_PER_ROOM=20

# Development-only debug mode. NEVER set to true in production.
DEBUG_MODE=false

# --- Privacy / trust ---
# TRUST_PROXY=true if behind a reverse proxy (rate limiting uses x-forwarded-for)
TRUST_PROXY=false
